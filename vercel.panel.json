{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@12.10.1 install --frozen-lockfile --filter panel...",
  "buildCommand": "npx --yes pnpm@12.10.1 --filter panel build",
  "outputDirectory": "apps/panel/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
