{
  "expo": {
    "name": "ProveCheck",
    "slug": "provecheck",
    "scheme": "provecheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "ProveCheck necesita tus fotos para adjuntar evidencia del servicio.",
          "cameraPermission": "ProveCheck necesita la cámara para fotografiar el servicio."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "backgroundColor": "#0F4C5C",
          "resizeMode": "contain"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "bundleIdentifier": "uy.provecheck.app",
      "infoPlist": {}
    },
    "android": {
      "package": "uy.provecheck.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F4C5C"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "icon": "./assets/icon.png",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ba96f9fe-8cda-44c0-a424-d2222c2d11eb"
      }
    },
    "owner": "evavargas"
  }
}
